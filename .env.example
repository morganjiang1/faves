# Everything works with none of these set: the app runs on bundled city data and stores
# your plans, saves and votes on the device. Set any of them to switch that service on.
# EXPO_PUBLIC_ values are built into the app, so use restricted keys or a proxy.

# Planner model: any OpenAI-compatible chat completions endpoint.
EXPO_PUBLIC_LLM_BASE_URL=
EXPO_PUBLIC_LLM_API_KEY=
EXPO_PUBLIC_LLM_MODEL=

# Google Routes API (real travel times and route lines) and Places API (New).
EXPO_PUBLIC_GOOGLE_MAPS_KEY=

# Yelp Fusion API (live ratings).
EXPO_PUBLIC_YELP_KEY=

# Supabase (sign-in, synced plans and live group votes).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Ticketmaster Discovery API (events and tickets).
EXPO_PUBLIC_TICKETMASTER_KEY=

# Public website address used in share links (defaults to this site on the web, the app link on a phone).
EXPO_PUBLIC_WEB_URL=
