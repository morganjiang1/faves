# Everything works with none of these set: the app runs on bundled city data and stores
# your plans, saves and votes on the device. Set any of them to switch that service on.
# EXPO_PUBLIC_ values are built into the app, so use restricted keys or a proxy.

# Planner model: any OpenAI-compatible chat completions endpoint.
EXPO_PUBLIC_LLM_BASE_URL=
EXPO_PUBLIC_LLM_API_KEY=
EXPO_PUBLIC_LLM_MODEL=

# Google Routes API (real travel times and route lines) and Places API (New).
EXPO_PUBLIC_GOOGLE_MAPS_KEY=

# Yelp Fusion API (live ratings).
EXPO_PUBLIC_YELP_KEY=

# Supabase (sign-in, synced plans and live group votes).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Ticketmaster Discovery API (events and tickets).
EXPO_PUBLIC_TICKETMASTER_KEY=

# Public website address used in share links (defaults to this site on the web, the app link on a phone).
EXPO_PUBLIC_WEB_URL=

# Group chats: the chat relay the app talks to (defaults to the computer serving the app, port 8787).
EXPO_PUBLIC_CHAT_URL=

# ---- Server side only (npm run chat-server, the agents in agents/, Convex). Never EXPO_PUBLIC_. ----

# Fetch.ai: Agentverse (registers the agents so ASI:One can find them) and the ASI:One model.
AGENTVERSE_API_KEY=
ASI_ONE_API_KEY=
# Where the agents reach the Faves server.
FAVES_API_URL=http://localhost:8787
# Invite links the Butler hands out (defaults to this computer's web build on port 8090).
FAVES_WEB_URL=

# Apify: live scouting through the Faves Local Spots Actor.
APIFY_TOKEN=

# Cartesia: the butler's voice and the booking call. FAVES_CALL_NUMBER is the number the
# booking call dials in a demo (a teammate playing the restaurant).
CARTESIA_API_KEY=
FAVES_CALL_NUMBER=
# Optional: a phone number for real outbound calls.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Convex: set by `npx convex dev`.
CONVEX_DEPLOYMENT=
EXPO_PUBLIC_CONVEX_URL=
